{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=km_ocr;Username=km_ocr;Password=km_ocr_password"
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "km_ocr",
    "SecretKey": "km_ocr_password",
    "BucketName": "documents",
    "UseSsl": false,
    "PreviewUrlMinutes": 10
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "km_ocr",
    "Password": "km_ocr_password",
    "OcrQueueName": "ocr.jobs"
  },
  "PaddleOcr": {
    "PythonExecutable": "python3",
    "ScriptPath": "Ocr/paddle_ocr_service.py",
    "Languages": "tha+eng",
    "TimeoutSeconds": 120
  },
  "Ai": {
    "Provider": "Ollama"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1",
    "TimeoutSeconds": 120
  },
  "OpenSearch": {
    "Url": "http://localhost:9200",
    "IndexName": "km-documents"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
